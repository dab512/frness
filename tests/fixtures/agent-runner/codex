#!/usr/bin/env node
import { appendFileSync } from "node:fs";
if (process.env.CLI_MARKER) appendFileSync(process.env.CLI_MARKER, "spawn\n");
let prompt = "";
for await (const chunk of process.stdin) prompt += chunk.toString();
const emit = value => process.stdout.write(`${JSON.stringify(value)}\n`);
emit({ type: "thread.started", thread_id: "native-codex-session" });
if (prompt === "hold") {
  emit({ type: "test.ready", pid: process.pid });
  await new Promise(resolve => { const timer = setInterval(() => {}, 1000); process.on("SIGINT", () => { clearInterval(timer); resolve(); }); });
  emit({ type: "turn.failed" });
  process.exit(0);
}
if (prompt === "hold-then-answer") {
  emit({ type: "test.ready", pid: process.pid });
  await new Promise(resolve => { const timer = setInterval(() => {}, 1000); process.on("SIGUSR1", () => { clearInterval(timer); resolve(); }); });
}
emit({ type: "item.completed", item: { id: "message", type: "agent_message", text: prompt } });
if (prompt !== "missing-final") emit({ type: "turn.completed", ...(prompt === "unknown-usage" ? {} : { usage: { input_tokens: 10, output_tokens: 3 } }), authorization: "must-be-redacted" });
