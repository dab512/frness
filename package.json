{
  "name": "frness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x",
    "npm": ">=11"
  },
  "workspaces": [
    "packages/*",
    "plugins/*",
    "apps/*",
    "specs/fractal-harness"
  ],
  "scripts": {
    "scaffold": "node tools/scaffold.mjs",
    "boot:build": "tsx tools/build-bootstrap.mjs",
    "boot:inspect": "tsx tools/inspect-bootstrap.mjs",
    "runtime:build": "tsx tools/build-runtime.mjs",
    "selfhost": "tsx apps/cli/src/selfhost.ts",
    "cli:build": "tsx tools/build-cli.mjs",
    "daemon": "tsx apps/daemon/src/main.ts",
    "frness": "tsx apps/cli/src/main.ts",
    "progress": "node tools/progress.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "spec:check": "npm run check --workspace fractal-harness-specification",
    "check:boundaries": "node tools/check-boundaries.mjs",
    "test:atom": "tsx --test",
    "test": "tsx --test tests/atoms/*.test.ts",
    "test:acceptance": "npm run test:acceptance --workspace fractal-harness-specification",
    "verify": "node tools/verify.mjs",
    "desktop": "node tools/desktop.mjs",
    "test:desktop": "tsx --test tests/desktop/*.test.ts",
    "plugin": "tsx apps/cli/src/plugins.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "electron": "44.7.2",
    "esbuild": "0.28.2",
    "playwright": "1.64.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
